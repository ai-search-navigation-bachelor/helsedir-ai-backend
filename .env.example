# ===========================================
# Helsedirektoratet AI Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to git (it's in .gitignore)

# ============
# Server
# ============
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ============
# Data Paths
# ============
CONTENT_FILE=data/content.json
LOGS_FILE=logs/logs.jsonl

# ============
# Helsedirektoratet API
# ============
# Register at https://utvikler.helsedirektoratet.no
# Subscribe to relevant API products to get your key
HELSEDIR_API_KEY=
HELSEDIR_API_URL=https://api.helsedirektoratet.no

# ============
# Optional: OpenAI (for chat/RAG features)
# ============
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============
# Optional: Debug Mode
# ============
# Set to "true" to see detailed configuration on startup
DEBUG=false
