# ===========================================
# Helsedirektoratet AI Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to git (it's in .gitignore)

# ============
# Server
# ============
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=WARNING

# ============
# MySQL Database
# ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=helsedir_ai

# ============
# Helsedirektoratet API
# ============
# Register at https://utvikler.helsedirektoratet.no
HELSEDIR_API_KEY=
HELSEDIR_NKI_API_KEY=

# ============
# Search Scoring Weights
# ============
SEARCH_EXACT_PHRASE_TITLE_WEIGHT=10.0
SEARCH_FULL_TITLE_COVERAGE_WEIGHT=7.0
SEARCH_KEYWORD_TITLE_WEIGHT=3.0

# ============
# Machine Learning
# ============
# Embedding model: use "intfloat/multilingual-e5-base" or "models/finetuned-e5-gpl"
ML_EMBEDDING_ENABLED=false
ML_EMBEDDING_MODEL=intfloat/multilingual-e5-base
ML_RANKING_ENABLED=false
ML_MODELS_DIR=models

# ============
# LLM API Keys
# ============
# OpenAI
OPENAI_API_KEY=

# Groq (up to 6 keys for parallel query generation, 30 req/min each)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
