# ===========================================
# Helsedirektoratet AI Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to git (it's in .gitignore)

# ============
# Server
# ============
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ============
# Helsedirektoratet API
# ============
# Register at https://utvikler.helsedirektoratet.no
# Subscribe to relevant API products to get your key
HELSEDIR_API_KEY=
HELSEDIR_API_URL=https://api.helsedirektoratet.no

# ============
# Optional: OpenAI (for chat/RAG features)
# ============
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============
# Optional: Debug Mode
# ============
# Set to "true" to see detailed configuration on startup
DEBUG=false

# ============
# Search Scoring Weights
# ============
# Adjust these to tune search relevance
SEARCH_EXACT_PHRASE_TITLE_WEIGHT=10.0
SEARCH_FULL_TITLE_COVERAGE_WEIGHT=7.0
SEARCH_KEYWORD_TITLE_WEIGHT=3.0
SEARCH_KEYWORD_BODY_WEIGHT=1.0
SEARCH_EXACT_PHRASE_BODY_WEIGHT=2.0
SEARCH_TAG_MATCH_WEIGHT=2.0

# ============
# Machine Learning (Optional)
# ============
# Enable these after training models with scripts/train_*.py

# Semantic search using TensorFlow embeddings
# When true: Computes semantic similarity between query and content
# When false: Uses only keyword-based scoring
ML_EMBEDDING_ENABLED=false

# Learning-to-rank model for result ordering
# When true: Re-ranks results using trained ML model based on click data
# When false: Uses baseline scoring weights defined above
ML_RANKING_ENABLED=false

# Directory where trained models are stored
ML_MODELS_DIR=models

# ============
# MySQL Database
# ============
# Database for caching Helsedir content and tracking statistics
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=helsedir_ai
